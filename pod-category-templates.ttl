@prefix pod: <http://mee.foundation/ontologies/pod#> .
@prefix ctpl: <http://mee.foundation/ontologies/pod-templates#> .
@prefix podcat: <http://mee.foundation/ontologies/pod-categories#> .
@prefix pshapes: <http://mee.foundation/ontologies/persona/shapes#> .
@prefix petshapes: <http://mee.foundation/ontologies/pets/shapes#> .
@prefix vehicleshapes: <http://mee.foundation/ontologies/vehicles/shapes#> .
@prefix idocshapes: <http://mee.foundation/ontologies/identity-documents/shapes#> .
@prefix mashapes: <http://mee.foundation/ontologies/medical-appointments/shapes#> .
@prefix sashapes: <http://mee.foundation/ontologies/service-accounts/shapes#> .
@prefix bankingshapes: <http://mee.foundation/ontologies/banking/shapes#> .
@prefix residenceshapes: <http://mee.foundation/ontologies/residences/shapes#> .
@prefix itineraryshapes: <http://mee.foundation/ontologies/itineraries/shapes#> .
@prefix oshapes: <http://mee.foundation/ontologies/organization/shapes#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/pod-templates> .

<http://mee.foundation/ontologies/pod-templates> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/pod-templates/4.3.0> ;
    dc:date "2026-09-19"^^xsd:date ;
    owl:imports <http://mee.foundation/ontologies/pod> ;
    owl:versionInfo "Version 4.3.0 - the category ontology renamed to pod-categories, with the cat: prefix becoming podcat:"@en ;
    rdfs:label "Pod Templates"@en ;
    rdfs:comment """Class-level pod:Pod templates for category concepts (pod-categories.ttl's podcat:PodCategoryScheme). Each individual here is what the app clones into a new pod when a pod of its own pod:category concept is first instantiated into a user's tree (Lazy Instantiation) — finding the template for a given category is a reverse lookup (?tc pod:category podcat:X), since pod-categories.ttl carries no forward pointer of its own. Each is typed solely pod:TemplatePod, and carries pod:memberShape for the member baseline plus zero or more pod:declaresTool nodes naming the tools — a pod:Form and its governing pod:formShape — a pod of that category is created with. Most declare none: most categories have nothing structured to say beyond their member baseline, and a pod cloned from such a template can still gain tools later, chosen by the user."""@en .

#################################################################
#  podcat:Person  (SKOS top concept)
#################################################################

ctpl:PersonTemplatePod rdf:type pod:Pod, pod:TemplatePod ;
    rdfs:label "Person Template Pod"@en ;
    rdfs:comment """The template for podcat:Person, one of the scheme's two SKOS top concepts. A pod
                    instantiated directly as bare "Person" is the root of a user's own tree of
                    pods — purely organizational, with no document, account or third party of its
                    own — so it carries only the contact-info member view every template shares,
                    and declares no tool."""@en ;
    pod:category podcat:Person ;
    pod:memberShape pshapes:ContactInfoShape .

#################################################################
#  podcat:Organization  (SKOS top concept)
#################################################################

ctpl:OrganizationTemplatePod rdf:type pod:Pod, pod:TemplatePod ;
    rdfs:label "Organization Template Pod"@en ;
    rdfs:comment """The template for podcat:Organization, one of the scheme's two SKOS top concepts. A
                    pod instantiated directly as bare "Organization" stands for the organization
                    itself — an employer, say — so it declares a pod:Form carrying that
                    organization's own o:Organization profile, the same
                    oshapes:OrganizationShape podcat:Groups uses."""@en ;
    pod:category podcat:Organization ;
    pod:memberShape pshapes:ContactInfoShape ;
    pod:declaresTool [ rdf:type pod:Form ;
                        pod:formShape oshapes:OrganizationShape ] .

