@prefix itineraries: <http://mee.foundation/ontologies/itineraries#> .
@prefix persona: <http://mee.foundation/ontologies/persona#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/itineraries> .

<http://mee.foundation/ontologies/itineraries> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/itineraries/1.4.0> ;
    dc:date "2026-09-18"^^xsd:date ;
    owl:versionInfo "Version 1.4.0 - vocabulary CURIEs moved to the pod: prefix of the Pod Ontology"@en ;
    rdfs:label "Itineraries Ontology"@en ;
    rdfs:comment """A small other/ peer ontology (see other/pets.ttl's own rdfs:comment for the
                    general pattern) for a domain a person merely *has* — a specific trip itinerary
                    being planned or taken — rather than *is*, kept out of persona.ttl the same way
                    pet/vehicle/identity-document domain-modeling already are. persona.ttl carries no
                    thin hasX-link property of its own pointing at itineraries:Itinerary — an
                    itinerary is always held by a pod:Form on its own Trips-category pod
                    (see cat:Trips's template pod, cat-templates.ttl), so no explicit Person-level
                    link is needed.

                    itineraries:Itinerary is an independent template type label class, asserted via
                    rdf:type directly on the graph's own content individual and targeted directly by
                    its own SHACL shape (other/shacl/itineraries-shacl.ttl) — independent of pod.ttl's
                    pod:shape property, whose own range is sh:NodeShape (the validating shape, not
                    the content's own class)."""@en .


#################################################################
#    Itinerary
#################################################################

itineraries:Itinerary rdf:type owl:Class ;
    rdfs:label "Itinerary"@en ;
    rdfs:comment """Label for a graph whose purpose is to carry one of a person's
                    trip itineraries — a specific journey being planned or taken, as distinct
                    from cat:Travel's broader loyalty-program/airline information. Unlike
                    serviceaccounts:ServiceAccount/banking:DebitCard/residences:Residence, it is not
                    multi-typed alongside any existing CCO/domain class, since no domain
                    ontology models trip-planning data yet — it carries no structured properties
                    of its own beyond a human-readable rdfs:label and/or rdfs:comment describing
                    the trip (destination, dates, itinerary notes, etc. as free text). Asserted
                    via rdf:type directly on the graph file's own individual, validated by the
                    SHACL shape :ItineraryShape in other/shacl/itineraries-shacl.ttl, linked from
                    cat:Trips's own class-level pod (cat-templates.ttl) via
                    pod:formShape. Not an identitydocuments:IdentityDocument."""@en .
