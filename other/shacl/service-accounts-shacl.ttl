@prefix : <http://mee.foundation/ontologies/service-accounts/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix serviceaccounts: <http://mee.foundation/ontologies/service-accounts#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://mee.foundation/ontologies/service-accounts/shapes> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/service-accounts> ;
    owl:versionIRI <http://mee.foundation/ontologies/service-accounts/shapes/1.4.0> ;
    dc:date "2026-09-18"^^xsd:date ;
    rdfs:label "Service Accounts Template SHACL Shapes"@en ;
    rdfs:comment """SHACL shapes for validating graph files carrying pod:shape sashapes:ServiceAccountShape.
                    Apply in addition to shacl/persona-shacl.ttl when validating a service account graph file.
                    Targets serviceaccounts:ServiceAccount individuals directly — also typed cco:ent00000033
                    (Online Service Account), so its own existing service-name/user-handle/service-URI
                    properties are constrained here without any change to their domain. Paired with
                    other/service-accounts.ttl, the ontology it validates."""@en .


#################################################################
#  Service Account Shape
#  Targets serviceaccounts:ServiceAccount individuals (also typed cco:ent00000033).
#  Required: username (cco:ent00000035 has user handle, 1..1)
#            password (serviceaccounts:hasPassword, 1..1)
#  Optional: service name (cco:ent00000034 has service name, 0..1)
#            service URI (cco:ent00000036 has service URI, 0..1)
#            loyalty program ID (serviceaccounts:loyaltyProgramID, 0..1)
#################################################################

:ServiceAccountShape
    a sh:NodeShape ;
    sh:targetClass serviceaccounts:ServiceAccount ;
    sh:message "Service Account validation: username and password are required."@en ;

    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ent00000035> ;  # has user handle
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A ServiceAccount must record exactly one username (user handle)."@en
    ] ;

    sh:property [
        sh:path serviceaccounts:hasPassword ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A ServiceAccount must record exactly one password."@en
    ] ;

    # ── Optional fields ──────────────────────────────────────────────────────
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ent00000034> ;  # has service name
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A ServiceAccount may record at most one service name."@en
    ] ;

    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ent00000036> ;  # has service URI
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:message "A ServiceAccount may record at most one service URI."@en
    ] ;

    # Optional, since most online service accounts carry no loyalty program at
    # all — present only on the ones held with a provider that runs one.
    # xsd:string rather than a numeric datatype: a real program ID is an opaque
    # identifier that may carry leading zeros or non-digit characters.
    sh:property [
        sh:path serviceaccounts:loyaltyProgramID ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A ServiceAccount may record at most one loyalty program ID."@en
    ] .
