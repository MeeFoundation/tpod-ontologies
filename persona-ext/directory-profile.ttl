@prefix directoryprofile: <http://mee.foundation/ontologies/directory-profile#> .
@prefix persona: <http://mee.foundation/ontologies/persona#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/directory-profile> .

<http://mee.foundation/ontologies/directory-profile> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/directory-profile/1.3.0> ;
    dc:date "2026-09-21"^^xsd:date ;
    owl:versionInfo "Version 1.3.0 - added jobFunction, on a CCO Occupation Role"@en ;
    rdfs:label "Directory Profile Ontology"@en ;
    rdfs:comment """The first persona-ext/ peer ontology: the fields a membership directory asks of
                    its members — when they joined, who sponsored them, what industry they work in
                    and what they do there, their assistant, their spouse and family, where they
                    grew up, their career history and recognitions, and the short free-text answers
                    a directory prints under their name.

                    persona-ext/ vs. other/ — the two families are told apart by one test, the
                    subject of the properties in the file:

                      other/           the subject is a record, document, or possession the person
                                       merely *has* — an independent continuant with an existence
                                       of its own (pets:Pet, idoc:Passport,
                                       education:EducationRecord).
                      persona-ext/     the subject is the persona:Person themselves, but the terms
                                       are too narrow to earn a place in persona.ttl.

                    Almost every property declared here has rdfs:domain persona:Person. The one
                    exception, directoryprofile:jobFunction, has domain cco:ont00000984 (Occupation
                    Role) — still the person as subject, reached through a specifically dependent
                    continuant that inheres in them and could not exist without them, which is a
                    world away from the independent things other/ describes. What keeps all of it
                    out of persona.ttl is breadth: persona.ttl carries what any application
                    recording a person needs, and — per persona:ContactInfo's own rdfs:comment —
                    what is "reused across every category's member graph". These fields are asked
                    by membership directories and the like, so they are a shared extension rather
                    than core.

                    No individual organization's requirements appear here. Which of these fields a
                    given organization requires and caps is a SHACL matter, carried by that
                    organization's own shape — see
                    pod-category-ext/shacl/boston-hub-society-shacl.ttl, which requires none of them but
                    freezes directoryprofile:industry to the Boston Hub Society's own 19-value list.
                    A fixed value list follows whoever owns it: an organization's own arbitrary list
                    belongs in that organization's shape, whereas a published national standard is
                    nobody's to vary, so directoryprofile:jobFunction's list is frozen once in this
                    file's own shape instead. Nothing here is BHS-specific; any club, alumni
                    association, or professional directory can reuse the whole file.

                    Referenced by name with no owl:imports in either direction, the same pattern
                    persona.ttl's other/ links already use."""@en .


#################################################################
#    DirectoryProfile
#################################################################

directoryprofile:DirectoryProfile rdf:type owl:Class ;
    rdfs:label "Directory Profile"@en ;
    rdfs:comment """Label for a graph whose purpose is to carry a person's entry in a membership
                    directory. Never asserted via rdf:type anywhere — a label only, exactly like
                    persona:ContactInfo (persona.ttl), and for the same reason: the individual a
                    directory profile describes is already a persona:Person, and the graph's own
                    pod:shape value names the validating shape directly. An organization's member
                    shape therefore targets persona:Person, not this class."""@en .


#################################################################
#  1. Membership
#################################################################

directoryprofile:memberSince rdf:type owl:DatatypeProperty ;
    rdfs:label "member since"@en ;
    rdfs:comment """The date the person became a member of the organization whose directory this
                    is. Which organization that is comes from the pod the graph sits in, not from
                    this property — a person's memberships each live in their own pod."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:date .

directoryprofile:sponsoredBy rdf:type owl:DatatypeProperty ;
    rdfs:label "sponsored by"@en ;
    rdfs:comment """The name of the existing member who sponsored or nominated this person for
                    membership, where the organization admits members that way. A bare string, not
                    a link to a persona:Person: the sponsor is named on a form, and the directory
                    has no claim that they are a user of this app."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .


#################################################################
#  2. Professional
#################################################################

directoryprofile:industry rdf:type owl:DatatypeProperty ;
    rdfs:label "industry"@en ;
    rdfs:comment """The industry the person works in. Repeat the property for more than one — a
                    person may work across several. Deliberately left as a bare string here: every
                    directory has its own list, so the permitted values are enumerated by the
                    asking organization's own shape (sh:in) rather than frozen in this file."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .

directoryprofile:industryOther rdf:type owl:DatatypeProperty ;
    rdfs:label "industry other"@en ;
    rdfs:comment """The free-text industry a person gives when none of the organization's listed
                    industries fits — the "Other:" box that accompanies a closed list. Separate
                    from directoryprofile:industry precisely because that property's values are
                    constrained to the organization's list."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .

directoryprofile:jobFunction rdf:type owl:DatatypeProperty ;
    rdfs:label "job function"@en ;
    rdfs:comment """The broad functional area of the person's work — one of the 23 job families of
                    the 2018 US Standard Occupational Classification, as O*NET publishes them.
                    Where directoryprofile:industry says what the employer does, this says what the
                    person does inside it. Unlike that property, whose values every directory sets
                    for itself, this list is a published national standard, so it is frozen once in
                    persona-ext/shacl/directory-profile-shacl.ttl rather than in each asking
                    organization's shape. There is no companion "Other" property: the 23 families
                    partition the entire civilian and military labor force, so a value outside them
                    means the person was mis-classified, not that the list is short.

                    Domain is cco:ont00000984 (Occupation Role, CCO AgentOntology) rather than
                    persona:Person: a job function classifies the role a person bears in virtue of
                    the responsibilities they are expected to fulfill within some act of employment,
                    and CCO already has the class for exactly that. The person reaches it via
                    BFO_0000196 (bearer of), the same relation persona.ttl already uses to reach a
                    person's qualities. persona:JobTitle remains the *name* of the post ("Software
                    Engineer"); this is the classification of it, and the two are independent — a
                    person may carry either, both, or neither.

                    Kept as a bare string rather than a reified cco:ont00000293 (Nominal
                    Measurement Information Content Entity), which is what CCO would use if the
                    classification act itself needed representing; nothing here asks who classified
                    the role or when."""@en ;
    rdfs:domain <https://w3id.org/cco-domains/cco/ont00000984> ;
    rdfs:range xsd:string .

directoryprofile:assistantName rdf:type owl:DatatypeProperty ;
    rdfs:label "assistant name"@en ;
    rdfs:comment """The name of the person's work assistant, where a directory routes contact
                    through one."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .

directoryprofile:assistantEmail rdf:type owl:DatatypeProperty ;
    rdfs:label "assistant email"@en ;
    rdfs:comment """The work assistant's email address. A bare string on the member rather than a
                    cco:ent00000024 (EmailAddress) designator: it designates the assistant, not the
                    member, and the assistant has no individual of their own here."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .

directoryprofile:previousPositions rdf:type owl:DatatypeProperty ;
    rdfs:label "previous positions"@en ;
    rdfs:comment """The person's previous work and life positions — military service, companies,
                    years worked. Free text: a directory asks for this as a single written answer,
                    so it is stored as one, rather than acquiring a structure the question never
                    had."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .

directoryprofile:directorships rdf:type owl:DatatypeProperty ;
    rdfs:label "directorships"@en ;
    rdfs:comment """Board directorships, past and present. Free text, for the same reason
                    directoryprofile:previousPositions is."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .

directoryprofile:nonProfitPositions rdf:type owl:DatatypeProperty ;
    rdfs:label "non-profit positions"@en ;
    rdfs:comment """Positions held with non-profit organizations. Free text, for the same reason
                    directoryprofile:previousPositions is."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .

directoryprofile:recognitions rdf:type owl:DatatypeProperty ;
    rdfs:label "recognitions"@en ;
    rdfs:comment """Awards, honors, and recognitions — a hall of fame induction, a lifetime
                    achievement award, a published list. Free text, for the same reason
                    directoryprofile:previousPositions is."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .


#################################################################
#  3. Family
#################################################################

directoryprofile:spousePartnerName rdf:type owl:DatatypeProperty ;
    rdfs:label "spouse or partner name"@en ;
    rdfs:comment """The name of the person's spouse or partner. A bare string rather than a link to
                    a persona:Person or a persona:hasSocialNetwork membership: a directory prints
                    the name it was given, and makes no claim that the spouse is a user of this
                    app. Where a real modeled relationship is wanted, that belongs in a pod of its
                    own under podcat:ImmediateFamily, not in a directory entry."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .

directoryprofile:spousePartnerBirthDate rdf:type owl:DatatypeProperty ;
    rdfs:label "spouse or partner birth date"@en ;
    rdfs:comment """The birth date of the person's spouse or partner, where the directory asks for
                    it. Paired with directoryprofile:spousePartnerName; both are single-valued, so
                    no reification is needed to keep the name and the date together."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:date .

directoryprofile:family rdf:type owl:DatatypeProperty ;
    rdfs:label "family"@en ;
    rdfs:comment """The person's children and other family, with years of birth. Free text: the
                    question is asked as one written answer, and the people named are not
                    individuals in this app's data."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .


#################################################################
#  4. Background and personal
#################################################################

directoryprofile:hometown rdf:type owl:DatatypeProperty ;
    rdfs:label "hometown"@en ;
    rdfs:comment """The city, state, and country where the person grew up — where several, the one
                    most formative. Free text, not a cco:ent00000010 (USPostalAddress): it is a
                    place a person names, not an address anything is delivered to."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .

directoryprofile:dietaryRestrictions rdf:type owl:DatatypeProperty ;
    rdfs:label "dietary restrictions"@en ;
    rdfs:comment """Dietary restrictions the organization needs when catering its events. Free
                    text — an allergy, an observance, a preference — since no useful closed list
                    exists."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .

directoryprofile:personalGoals rdf:type owl:DatatypeProperty ;
    rdfs:label "personal goals"@en ;
    rdfs:comment """What the person is working toward, in their own words. Free text, for the same
                    reason directoryprofile:previousPositions is."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .

directoryprofile:lifeExperiences rdf:type owl:DatatypeProperty ;
    rdfs:label "life experiences"@en ;
    rdfs:comment """Interesting life experiences, in the person's own words — the biographical
                    answer a directory prints alongside the factual fields. Free text, for the same
                    reason directoryprofile:previousPositions is.

                    Distinct from persona:PersonalInfo (persona.ttl), which carries a person's
                    hobbies, interests, and areas of expertise as structured kind/value pairs: a
                    directory's Interests/Hobbies question reuses that class rather than adding a
                    property here."""@en ;
    rdfs:domain persona:Person ;
    rdfs:range xsd:string .
