#################################################################
#  No category (Custom / UserDefined pods)
#################################################################

ctpl:UserDefinedTemplatePod rdf:type pod:Pod, pod:TemplatePod ;
    rdfs:label "User-Defined (No Category) Template Pod"@en ;
    rdfs:comment """The one pod:TemplatePod with no pod:category value at all — for a pod the
                    user creates without picking any existing category concept (the Custom/
                    UserDefined case, identified by the pod carrying no category value
                    at all; this repo's scaffolding mirrors it in the pod-databook
                    filename's (custom) disambiguator). Since it has no
                    pod:category, it isn't reachable by the usual ?tc pod:category cat:X
                    reverse lookup every other template pod uses — it's found instead as the
                    unique pod:TemplatePod carrying no pod:category value, and Lazy
                    Instantiation falls back to cloning it whenever a new pod is created with no
                    category selected. Carries only pod:memberShape
                    pshapes:ContactInfoShape — a Custom pod has no document type and no
                    tool content of its own, only ever a contact-info view of its member(s)."""@en ;
    pod:memberShape pshapes:ContactInfoShape .

