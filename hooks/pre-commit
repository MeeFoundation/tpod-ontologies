#!/usr/bin/env bash
# Regenerate the .mmd and .png diagram for every graph embedded in a staged
# pod-databook, and stage the results alongside it.
#
# Install: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# helpers/draw.py takes a pod-databook plus one graph id and always writes
# <graph-NN>.mmd/.png into example/graphs/images/, so this hook enumerates each
# staged databook's own v4.member and v4.tool[].graph ids and draws them one by one,
# from the repo root (draw.py resolves its output path relative to the cwd).
#
# Note: draw.py is not byte-deterministic — its literal node ids are rehashed on
# every run, so a regenerated .mmd diffs even when the diagram is unchanged. Set
# SKIP_DRAW=1 to bypass this hook for a commit that shouldn't carry that noise.

set -euo pipefail

[ "${SKIP_DRAW:-0}" = "1" ] && exit 0

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged=$(git diff --cached --name-only --diff-filter=ACM | grep '^example/Pods/.*\.databook\.md$' || true)
[ -z "$staged" ] && exit 0

command -v mmdc >/dev/null 2>&1 || echo "[draw] warning: mmdc not found — .png files will not be regenerated"

while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -f "$f" ] || continue

    graphs=$(PYTHONPATH=helpers python3 -c '
import sys, yaml
from databook_graphs import as_list, split_frontmatter
fm_text, _, _ = split_frontmatter(open(sys.argv[1]).read())
v4 = (yaml.safe_load(fm_text) or {}).get("v4") or {}
entries = [e for e in as_list(v4.get("member")) if isinstance(e, dict)]
for tool in as_list(v4.get("tool")):
    if isinstance(tool, dict):
        entries += [g for g in as_list(tool.get("graph")) if isinstance(g, dict)]
for e in entries:
    if e.get("id"):
        print(e["id"].rsplit("/", 1)[-1])
' "$f")

    while IFS= read -r g; do
        [ -n "$g" ] || continue
        echo "[draw] $f  $g"
        python3 helpers/draw.py "$f" "$g"
        [ -f "example/graphs/images/$g.mmd" ] && git add "example/graphs/images/$g.mmd"
        [ -f "example/graphs/images/$g.png" ] && git add "example/graphs/images/$g.png"
    done <<< "$graphs"
done <<< "$staged"
