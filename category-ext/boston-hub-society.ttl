@prefix bhscat: <http://mee.foundation/ontologies/category-ext/boston-hub-society#> .
@prefix cat: <http://mee.foundation/ontologies/category#> .
@prefix pod: <http://mee.foundation/ontologies/pod#> .
@prefix bhsshapes: <http://mee.foundation/ontologies/category-ext/boston-hub-society/shapes#> .
@prefix oshapes: <http://mee.foundation/ontologies/organization/shapes#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/category-ext/boston-hub-society> .

<http://mee.foundation/ontologies/category-ext/boston-hub-society> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/category-ext/boston-hub-society/1.1.0> ;
    dc:date "2026-09-18"^^xsd:date ;
    owl:imports <http://mee.foundation/ontologies/pod> ;
    owl:versionInfo "Version 1.1.0 - vocabulary CURIEs moved to the pod: prefix of the Pod Ontology"@en ;
    rdfs:label "Boston Hub Society Category Extension"@en ;
    rdfs:comment """The first **category extension** — a self-contained bundle an organization
                    publishes so that other instances of the app can file and validate pods of a
                    category the app's own taxonomy does not define. One file carries the whole
                    bundle: the publisher's skos:ConceptScheme, the concepts in it, and the
                    pod:TemplatePod for each. Its member shape lives beside it in
                    category-ext/shacl/.

                    Why an extension rather than a new concept in category.ttl: cat:CategoryScheme
                    is this app's curated taxonomy of the kinds of thing a person tracks — Groups,
                    Medical, Vehicles. A single named organization is not one of those kinds; it is
                    an instance of one. Adding it there would grow the shipped taxonomy by one
                    concept per organization anyone ever joins, and would oblige cat-templates.ttl to
                    grow with it (integrity.md's TTL-6). Neither file changes to add an extension.

                    How the link into the core taxonomy is made: with skos:broadMatch, not
                    skos:broader. SKOS reserves skos:broader for hierarchy *within* one concept
                    scheme and provides the skos:mappingRelation family — of which skos:broadMatch is
                    one — for links *between* schemes. An extension concept is by definition in
                    another scheme, so skos:broadMatch is the correct predicate and skos:broader
                    would be a misuse. The recipient's app reads the broadMatch to know where in its
                    own tree an incoming pod of this category should be filed — cat:Groups, here —
                    without having to know anything else about the publisher.

                    Every extension concept must carry exactly one skos:broadMatch into a concept of
                    cat:CategoryScheme; see integrity.md's TTL-8, which enforces it, and
                    shacl/pod-shacl.ttl's :PodShape, which no longer pins a pod:category value to
                    cat:CategoryScheme itself but still requires it to be a concept in some
                    skos:ConceptScheme."""@en .


#################################################################
#    The extension's own concept scheme
#################################################################

bhscat:BostonHubSocietyScheme rdf:type skos:ConceptScheme ;
    rdfs:label "Boston Hub Society Category Scheme"@en ;
    skos:prefLabel "Boston Hub Society Categories"@en ;
    skos:hasTopConcept bhscat:BostonHubSociety ;
    rdfs:comment """The Boston Hub Society's own concept scheme, holding the categories it
                    publishes. Separate from cat:CategoryScheme (category.ttl) on purpose: that is
                    the app's curated taxonomy, this is one organization's extension of it."""@en .


#################################################################
#    bhscat:BostonHubSociety
#################################################################

bhscat:BostonHubSociety rdf:type skos:Concept ;
    skos:prefLabel "Boston Hub Society"@en ;
    skos:broadMatch cat:Groups ;
    skos:inScheme bhscat:BostonHubSocietyScheme ;
    rdfs:comment """A person's membership of the Boston Hub Society — the society's own directory
                    entry for them, alongside the society's organizational profile. Narrower than
                    cat:Groups, the app's catch-all for clubs and societies, which is what an app
                    with this extension uninstalled would file such a pod under; the skos:broadMatch
                    above says exactly that."""@en .


#################################################################
#    The extension's template pod
#################################################################

bhscat:BostonHubSocietyTemplatePod rdf:type pod:Pod, pod:TemplatePod ;
    rdfs:label "Boston Hub Society Template Pod"@en ;
    rdfs:comment """The first pod:TemplatePod whose pod:memberShape is not
                    pshapes:ContactInfoShape. Every one of the 106 templates in cat-templates.ttl
                    carries that shape and nothing else, so a member graph is always validated as a
                    generic contact-info profile whatever its category (integrity.md's TTL-7).
                    The Boston Hub Society asks its members for considerably more than contact
                    information, on a two-page directory form, so its template names its own shape
                    instead — which is what pod:memberShape exists for.

                    That exception lives here rather than in cat-templates.ttl, which keeps its own
                    invariant intact: every template the app itself ships is uniform, and variation
                    arrives only with an extension.

                    The declared tool is unchanged from ctpl:GroupsTemplatePod's — a form carrying
                    the society's own o:Organization profile — since a pod of this category is
                    still a pod about a group."""@en ;
    pod:category bhscat:BostonHubSociety ;
    pod:memberShape bhsshapes:MemberShape ;
    pod:declaresTool [ rdf:type pod:Form ;
                        pod:formShape oshapes:OrganizationShape ] .
