@prefix : <http://mee.foundation/ontologies/persona/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix persona: <http://mee.foundation/ontologies/persona#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://mee.foundation/ontologies/persona/shapes/contactinfo> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/persona> ;
    owl:versionIRI <http://mee.foundation/ontologies/persona/shapes/contactinfo/1.5.0> ;
    dc:date "2026-09-18"^^xsd:date ;
    rdfs:label "ContactInfo Template SHACL Shapes"@en ;
    rdfs:comment """SHACL shapes for validating graph files carrying pod:shape pshapes:ContactInfoShape.
                    Apply in addition to shacl/persona-shacl.ttl when validating a Contact Info graph file."""@en .


#################################################################
#  ContactInfo
#  Required: GivenName (1..1)
#  Optional: OrganizationName, all other name components, OrganizationUnit,
#             JobTitle, contact channels (Email/Phone), addresses, online
#             services, anniversaries, personalInfo, photo
#################################################################

:ContactInfoShape
    a sh:NodeShape ;
    sh:targetClass persona:Person ;
    sh:message "ContactInfo validation: GivenName required, max 1 per name/org component."@en ;

    # ── Name components (max 1 each) ────────────────────────────────────────
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000001 ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one FullName."@en
    ] ;
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000002 ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo must have exactly one GivenName."@en
    ] ;
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000004 ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one FamilyName."@en
    ] ;
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000003 ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one AdditionalName (middle name)."@en
    ] ;
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000058 ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one Surname2 (maternal surname)."@en
    ] ;
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000057 ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one HonorificPrefix (Title)."@en
    ] ;
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000005 ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one generational Suffix."@en
    ] ;
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000006 ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one AlternateName."@en
    ] ;
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ont00000990 ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one Nickname."@en
    ] ;
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class persona:Credential ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one post-nominal Credential."@en
    ] ;

    # ── Birthdate (max 1) ───────────────────────────────────────────────────
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000046 ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one Birthdate."@en
    ] ;

    # ── Organization fields (all optional, max 1 each) ──────────────────────
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class cco:ent00000047 ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one OrganizationName."@en
    ] ;
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class persona:OrganizationUnit ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one OrganizationUnit."@en
    ] ;
    sh:property [
        sh:path <https://w3id.org/cco-domains/cco/ont00001879> ;
        sh:qualifiedValueShape [ sh:class persona:JobTitle ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A ContactInfo may have at most one JobTitle."@en
    ] .
    # ── Contact channels (fully optional, no lower or upper bound) ──────────
    # EmailAddress (ent00000024), TelephoneNumber (ent00000023),
    # USPostalAddress (ent00000010), OnlineServiceAccount (ont00000033),
    # WebURL (persona:WebURL), Anniversary (via persona:hasAnniversary),
    # PersonalInfo (via persona:hasPersonalInfo), Photo (via persona:hasPhoto)
    # — no sh:qualifiedMaxCount constraint; JSContact allows multiples.
