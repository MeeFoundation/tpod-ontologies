@prefix : <http://mee.foundation/ontologies/cell/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix cell: <http://mee.foundation/ontologies/cell#> .
@prefix p: <http://mee.foundation/ontologies/persona#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix service: <http://mee.foundation/ontologies/service#> .
@prefix cat: <http://mee.foundation/ontologies/category#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://mee.foundation/ontologies/cell/shapes> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/cell/shapes/9.2.1> ;
    dc:date "2026-09-15"^^xsd:date ;
    rdfs:label "Cell Ontology SHACL Validation Shapes"@en ;
    rdfs:comment "SHACL validation shapes for cell:Cell DataBook instances (the content facet of a cell) the cell:Tool nodes a cell carries, and the graph DataBook instances a cell links to — cell:MemberGraph via cell:member, cell:FormGraph via a tool's own cell:formGraph — in the Cell Ontology."@en .


#################################################################
#  Cell
#  cell:Cell carries only what's common to every cell regardless of
#  kind: category. A cell's folder is purely the filesystem folder its
#  cell-databook physically lives in, never a stored path, so there's
#  nothing to constrain here for that. Graph links (cell:member/
#  cell:tool) live on :InstanceCellShape below — since cell:TemplateCell
#  and cell:InstanceCell are disjoint (cell.ttl), that shape fires only
#  on the InstanceCell branch, not on template cells. The tool nodes
#  themselves are constrained by :LiveToolShape and :DeclaredToolShape,
#  which use sh:targetObjectsOf cell:tool / cell:declaresTool rather
#  than a class, since the same tool classes serve both roles.
#################################################################

:CellShape
    a sh:NodeShape ;
    sh:targetClass cell:Cell ;
    sh:message "Cell validation."@en ;

    # cell:category — at most one value (0..1), on any cell:Cell
    # regardless of kind. Absent exactly when the cell is of the
    # UserDefined category — identified precisely by that absence
    # itself, not a vague "no canonical counterpart" judgment call.
    # This repo's scaffolding mirrors it in the cell-databook's
    # filename, which carries the literal "(custom)" disambiguator;
    # SHACL can't see filenames, so that absence/filename pairing is
    # checked in integrity.md's Check 20/10j, not here. Now
    # constrained via sh:class skos:Concept — category.ttl's tree is a
    # SKOS concept scheme, not an OWL class hierarchy, so a legal value
    # really is rdf:type skos:Concept, no class-value punning involved
    # (contrast vehicles:hasVehicleType, other/vehicles.ttl, which still
    # does pun a real class hierarchy). The nested skos:inScheme check
    # requires a legal value to belong to some concept scheme — sh:class
    # skos:Concept alone would accept a free-floating SKOS concept from
    # anywhere. It deliberately does *not* pin that scheme to
    # cat:CategoryScheme: a category extension (category-ext/) publishes
    # its concepts in its own scheme and links them to the app's taxonomy
    # with skos:broadMatch, which is what SKOS provides for cross-scheme
    # mapping (skos:broader being reserved for hierarchy within one
    # scheme). Requiring cat:CategoryScheme here would make every such
    # concept illegal as a cell:category value. What SHACL cannot check
    # is the other half — that an extension concept really does carry
    # exactly one skos:broadMatch into a cat:CategoryScheme concept, so
    # the recipient's app always knows where to file an incoming cell;
    # that is integrity.md's Check 39, which needs to dereference across
    # two files at once.
    sh:property [
        sh:path cell:category ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:property [
            sh:path skos:inScheme ;
            sh:minCount 1 ;
            sh:class skos:ConceptScheme ;
            sh:message "A cell:category value must be a concept in some skos:ConceptScheme — cat:CategoryScheme (category.ttl) for a core category, or an extension's own scheme (category-ext/), which must skos:broadMatch a core concept."@en
        ] ;
        sh:message "A cell may have at most one cell:category value: the category concept its content is filed under, if any."@en
    ] ;

    # rdf:type — exactly one of cell:TemplateCell/cell:InstanceCell, never
    # both and never neither, mirroring cell.ttl's owl:disjointWith
    # cell:TemplateCell cell:InstanceCell. A reusable class-level template
    # (cat-templates.ttl) is typed cell:TemplateCell only; every cell
    # in a user's own tree is typed cell:InstanceCell only — there is no
    # legal bare tree-position-only cell with no member content in the
    # InstanceCell branch (a category node with nothing substantive to
    # say still carries a minimal stub cell:member entry, see
    # integrity.md's Check 21) and no cell legally carries both kinds at
    # once.
    sh:xone (
        [ sh:property [ sh:path rdf:type ; sh:hasValue cell:TemplateCell ] ]
        [ sh:property [ sh:path rdf:type ; sh:hasValue cell:InstanceCell ] ]
    ) .


#################################################################
#  TemplateCell
#  cell:TemplateCell is the template facet of a cell — reusable content,
#  identified by its own cell:category value naming the category concept
#  (a skos:Concept in cat:CategoryScheme, category.ttl) it's a template
#  for — a reverse lookup, since category.ttl carries no forward pointer.
#################################################################

:TemplateCellShape
    a sh:NodeShape ;
    sh:targetClass cell:TemplateCell ;
    sh:message "Template Cell validation."@en ;

    # cell:memberShape — zero or more values, no maxCount. Not
    # constrained to sh:class
    # sh:NodeShape here: the individuals they point at (e.g.
    # idocshapes:PassportShape) are only typed sh:NodeShape in
    # the per-template other/shacl/*.ttl files, which the cell pass
    # deliberately excludes from its shapes (see example.md's Validation
    # section) — asserting sh:class here would spuriously fail there.
    sh:property [
        sh:path cell:memberShape ;
        sh:message "cell:memberShape links a cell:TemplateCell to zero or more sh:NodeShape values."@en
    ] ;

    # cell:declaresTool — zero or more cell:Tool nodes naming the tools a
    # cell of this category is created with. Most templates declare none.
    # There is no boolean flag saying whether such a cell holds structured
    # content: declaring the tool already says it, and a second statement
    # could only ever disagree with the first.
    sh:property [
        sh:path cell:declaresTool ;
        sh:class cell:Tool ;
        sh:message "cell:declaresTool links a cell:TemplateCell to zero or more cell:Tool nodes."@en
    ] .


#################################################################
#  InstanceCell
#  cell:InstanceCell is the actual/instantiated facet of a cell — real,
#  member-classified content. :InstanceCellShape constrains
#  cell:creator/cell:owner/cell:member, plus the two tag properties
#  cell:userTag/cell:serviceTag (see their own comment below; the
#  cell:ServiceTag value nodes cell:serviceTag points at are
#  constrained by :ServiceTagShape, further below) — cell:owner and cell:member are
#  each required, one or more values, no fixed upper bound (cell:creator
#  stays exactly one); cell:tool is zero or more here, with the shape of
#  each tool node enforced by :LiveToolShape, not here. Every cell:owner value must also be one of
#  the cell's active cell:member cell:subject values — an invariant
#  not itself SHACL-expressible (it requires dereferencing each linked
#  graph's own cell:subject), so it is checked only by CLAUDE.md's
#  own integrity check (Check 23), not here. There is no cell-level
#  subject to constrain: cell:subject is scoped to cell:MemberGraph
#  (:MemberGraphShape below), never asserted on a cell — a cell's own subject
#  is derived from its tools' own cell:formTopic values, or failing those
#  from its cell:member graphs' own cell:subject values, rather than
#  asserted directly (see cell.ttl's cell:tool comment; :LiveToolShape and
#  :MemberGraphShape below constrain those properties instead). There is likewise no
#  cell-level shape to constrain — an InstanceCell's validation shape is derived
#  from its own cell:category value (reverse-lookup the cell:TemplateCell
#  with the same cell:category, cat-templates.ttl) rather than stored on
#  the InstanceCell itself.
#################################################################

:InstanceCellShape
    a sh:NodeShape ;
    sh:targetClass cell:InstanceCell ;
    sh:message "Instance Cell validation."@en ;

    # cell:creator — exactly one value, required, must be a Person: a cell
    # is always created by a human, never by a service:Service and never by
    # an o:Organization, whose participation in a cell is always through the
    # service:ServiceProvider it provides.
    sh:property [
        sh:path cell:creator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class p:Person ;
        sh:message "A cell:InstanceCell must have exactly one cell:creator, a single p:Person."@en
    ] ;

    # cell:owner — one or more values, required, no fixed upper bound,
    # each must be a Person (never a service:Service — an invited service
    # can be a cell:member but can never be promoted to owner; see
    # cell.ttl's cell:owner comment).
    sh:property [
        sh:path cell:owner ;
        sh:minCount 1 ;
        sh:class p:Person ;
        sh:message "A cell:InstanceCell must have at least one cell:owner, each a p:Person."@en
    ] ;

    # cell:member — one or more values, required, no fixed upper bound.
    # Member count is never stored as a class — it's simply the number of
    # distinct subjects among a cell's members, counted at read time
    # when needed (a cell is not expected to ever have more than a couple
    # dozen members).
    sh:property [
        sh:path cell:member ;
        sh:minCount 1 ;
        sh:class cell:MemberGraph ;
        sh:message "A cell:InstanceCell's cell:member is required, at least one value, and each must be a cell:MemberGraph."@en
    ] ;

    # cell:tool — zero or more values, no minCount and no maxCount. A cell
    # carrying no tool is the ordinary case, not a lesser kind of cell, and
    # nothing caps how many it may carry: a cell gets one per tool its
    # category's template declares and the user may add more at any time.
    # The tool nodes' own contents are constrained by :LiveToolShape below.
    sh:property [
        sh:path cell:tool ;
        sh:class cell:Tool ;
        sh:message "A cell:InstanceCell's cell:tool values must each be a cell:Tool."@en
    ] ;

    # cell:userTag/cell:serviceTag — each zero or more values, no
    # minCount and no maxCount: a cell need carry no tags at all, and nothing
    # caps how many it may carry. Neither has an sh:in list, since a tag
    # belongs to no vocabulary at all (contrast vehicles:fuelType and
    # pets:sex, whose small closed vocabularies really are frozen that way).
    #
    # They are constrained to different depths, because they are different
    # shapes. cell:userTag is a literal, held to a non-empty string and
    # nothing further — sh:minLength 1 catches only the empty string, so the
    # rules SHACL cannot see for it (leading/trailing whitespace, a YAML
    # value that isn't a string at all, and duplicates, RDF being a set so a
    # repeated literal collapses before validation ever runs) are
    # integrity.md's Check 36 instead. cell:serviceTag's value is a
    # cell:ServiceTag node, and this block fixes only that: the node's
    # own three required parts are :ServiceTagShape's business below.
    sh:property [
        sh:path cell:userTag ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "A cell:userTag value must be a non-empty string."@en
    ] ;

    sh:property [
        sh:path cell:serviceTag ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class cell:ServiceTag ;
        sh:message "Each cell:serviceTag value must be a cell:ServiceTag node, not a literal."@en
    ] .


#################################################################
#  ServiceTag
#  cell:ServiceTag is the value node cell:serviceTag points at —
#  cell:tagNamespace (whose module wrote the tag), cell:tagKey (what kind
#  of external fact it records) and cell:tagValue (the label itself), each
#  required exactly once. A node missing any of the three records nothing
#  a module could act on; one carrying two of a single part would be two
#  tags, not one.
#
#  sh:pattern does the structural work sh:minLength alone cannot:
#  reverse-DNS well-formedness on the namespace, an identifier token on
#  the key, and — now that the label has a property of its own rather than
#  being one segment of an opaque string — no leading or trailing
#  whitespace on the value. What stays integrity.md's Check 36 is only
#  what no SHACL constraint can reach: a YAML sub-value that is not a
#  string at all (a bare 1.2 stringifies to "1.2" and passes the namespace
#  pattern), an entry that is not a mapping, an unrecognized extra
#  sub-key, and the same (namespace, key, value) triple twice on one cell
#  — two value nodes are distinct, so unlike two identical literals a
#  duplicate really is present after synthesis, but comparing sibling
#  nodes needs a SPARQL query rather than any core SHACL constraint.
#
#  sh:BlankNodeOrIRI rather than sh:BlankNode: helpers/databook_graphs.py
#  synthesizes a blank node, since a cell-databook's frontmatter has
#  nowhere to mint an IRI, but a named individual is equally legal — the
#  spelling an app writing straight into a triplestore would reach for.
#################################################################

:ServiceTagShape
    a sh:NodeShape ;
    sh:targetClass cell:ServiceTag ;
    sh:message "Service Tag validation: exactly one namespace, key and value are required."@en ;

    sh:property [
        sh:path cell:tagNamespace ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" ;  # reverse-DNS, two or more lowercase labels
        sh:message "cell:tagNamespace must be a DNS domain the writing module's developer controls, in reverse-DNS order: two or more lowercase labels, e.g. foundation.mee.applecontacts."@en
    ] ;

    sh:property [
        sh:path cell:tagKey ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[A-Za-z][A-Za-z0-9_-]*$" ;  # identifier token, no dot: a key is never a further namespace segment
        sh:message "cell:tagKey must be a letter followed by letters, digits, underscores or hyphens, e.g. group or recordID."@en
    ] ;

    sh:property [
        sh:path cell:tagValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:pattern "^\\S(.*\\S)?$" ;  # non-empty, single-line, no surrounding whitespace
        sh:message "cell:tagValue must be a non-empty single-line string with no leading or trailing whitespace."@en
    ] .


#################################################################
#  Tools
#  A cell:Tool node appears in two roles, told apart by which property
#  points at it rather than by its class, since both roles use the same
#  tool classes (cell:Form, cell:Calendar, cell:Canvas, cell:Map).
#  So these two shapes target sh:targetObjectsOf, never sh:targetClass:
#
#    :LiveToolShape     — a live tool, reached by cell:tool from a
#                         cell:InstanceCell. A live cell:Form
#                         carries cell:formTopic (exactly one) and
#                         cell:formGraph (at least one), never a shape;
#                         a live cell:Calendar or cell:Canvas
#                         carries none of the three, so each
#                         requirement is conditioned on cell:Form
#                         rather than asserted outright.
#    :DeclaredToolShape — a declaration, reached by cell:declaresTool
#                         from a cell:TemplateCell. Carries
#                         cell:formShape alone: a template cannot
#                         know what a future cell's tool will be about.
#
#  cell:formGraph's real upper bound — one value per cell member, each
#  with a distinct claimant — is a cross-property invariant SHACL can't
#  check here; see integrity.md's Check 25.
#################################################################

:LiveToolShape
    a sh:NodeShape ;
    sh:targetObjectsOf cell:tool ;
    sh:message "Tool validation."@en ;

    # All three tool-content properties are scoped to cell:Form
    # (cell.ttl), the one tool class with a content model, so the
    # requirements below are conditioned on the tool's class rather than
    # asserted outright: this shape targets every live tool, and a
    # cell:Calendar, cell:Canvas or cell:Map legitimately carries none
    # of them. A blanket sh:minCount here would fail those three.
    #
    # A live cell:Form carries cell:formTopic exactly once — what its
    # content is about, stated once on the tool rather than repeated on
    # each graph beneath it, so several members' claims about one thing
    # cannot disagree about what that thing is — and at least one
    # cell:formGraph. SHACL enforces only that minimum; the per-tool upper
    # bound, one graph per cell member each with a distinct claimant, is
    # integrity.md's Check 25.
    sh:or (
        [ sh:not [ sh:class cell:Form ] ]
        [ sh:property [
              sh:path cell:formTopic ;
              sh:minCount 1 ;
              sh:maxCount 1 ;
              sh:message "A live cell:Form must have exactly one cell:formTopic value."@en
          ] ;
          sh:property [
              sh:path cell:formGraph ;
              sh:minCount 1 ;
              sh:message "A live cell:Form must have at least one cell:formGraph value."@en
          ] ]
    ) ;

    # Whatever the tool kind, each cell:formGraph value is a cell:FormGraph.
    sh:property [
        sh:path cell:formGraph ;
        sh:class cell:FormGraph ;
        sh:message "A cell:Tool's cell:formGraph values must each be a cell:FormGraph."@en
    ] ;

    # A live tool never carries a shape — that belongs to the declared
    # role, on a cell:TemplateCell's own cell:declaresTool node.
    sh:property [
        sh:path cell:formShape ;
        sh:maxCount 0 ;
        sh:message "A live cell:Tool (reached by cell:tool) must not carry cell:formShape — that belongs to a declared tool."@en
    ] .

:DeclaredToolShape
    a sh:NodeShape ;
    sh:targetObjectsOf cell:declaresTool ;
    sh:message "Declared Tool validation."@en ;

    # cell:formShape — zero or more values. Not constrained to
    # sh:class sh:NodeShape here, for the same reason cell:memberShape
    # isn't: the individuals it points at are only typed sh:NodeShape in
    # the per-template other/shacl/*.ttl files, which the cell pass
    # deliberately excludes from its shapes.
    sh:property [
        sh:path cell:formShape ;
        sh:message "cell:formShape links a declared cell:Tool to zero or more sh:NodeShape values."@en
    ] ;

    # A declared tool carries neither of the live-tool properties.
    sh:property [
        sh:path cell:formTopic ;
        sh:maxCount 0 ;
        sh:message "A declared cell:Tool must not carry cell:formTopic — a template cannot know what a future cell's tool will be about."@en
    ] ;

    sh:property [
        sh:path cell:formGraph ;
        sh:maxCount 0 ;
        sh:message "A declared cell:Tool must not carry cell:formGraph — it declares a shape, not live content."@en
    ] .


#################################################################
#  Graph DataBooks (cell:CGraph and its two leaves)
#  Validates the classification fields on every graph DataBook a cell
#  links to — a graph DataBook only ever exists to be linked from a
#  cell (via cell:member, or via a tool's own cell:formGraph, above),
#  so its shapes live here
#  alongside the cell shapes rather than in a separate file.
#
#  Three shapes, mirroring cell.ttl's three levels. :CGraphShape
#  carries the cell:claimant constraint common to both kinds;
#  :MemberGraphShape carries cell:subject, the one about-ness property
#  a leaf still defines, and :FormGraphShape asserts that a tool graph
#  carries none — its about-ness is the holding tool's own
#  cell:formTopic (:LiveToolShape above). That sh:maxCount 0 is how the
#  owl:disjointWith between the two leaves becomes something a
#  validator can actually fail on.
#
#  :CGraphShape deliberately targets the two leaf classes rather than
#  cell:CGraph itself. sh:targetClass reaches subclass instances only
#  under rdfs:subClassOf entailment, and helpers/validate.py runs no
#  reasoner — helpers/databook_graphs.py emits the leaf type alone
#  (cell:MemberGraph or cell:FormGraph, never a bare cell:CGraph), so
#  targeting the abstract superclass would silently match nothing.
#  Listing both leaves keeps the claimant constraint declared once
#  while still firing on real data.
#################################################################

# cell:shape (domain cell:Graph, range sh:NodeShape) is deliberately left
# unconstrained by any shape here, for the identical reason :TemplateCellShape's
# own comment above already gives for not constraining cell:memberShape
# and cell:formShape to sh:class sh:NodeShape: the individuals a cell:shape
# value points at (e.g. idocshapes:PassportShape) are only typed
# sh:NodeShape in files (shacl/persona-shacl.ttl,
# shacl/contactinfo-shacl.ttl, and every other/shacl/*-shacl.ttl file)
# that the cell pass's own shapes deliberately exclude — asserting
# sh:class here would spuriously fail there.

:CGraphShape
    a sh:NodeShape ;
    sh:targetClass cell:MemberGraph, cell:FormGraph ;
    sh:message "CGraph validation: claimant must be exactly one Person, Organization, or Service."@en ;
    sh:property [
        sh:path cell:claimant ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class p:Person ] [ sh:class o:Organization ] [ sh:class service:Service ] ) ;
        sh:message "cell:claimant must have exactly one value, and it must be a p:Person, o:Organization, or service:Service."@en
    ] .

:MemberGraphShape
    a sh:NodeShape ;
    sh:targetClass cell:MemberGraph ;
    sh:message "MemberGraph validation: subject must be exactly one IRI."@en ;
    sh:property [
        sh:path cell:subject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "cell:subject must have exactly one value, and it must be an IRI."@en
    ] .

:FormGraphShape
    a sh:NodeShape ;
    sh:targetClass cell:FormGraph ;
    sh:message "FormGraph validation: no subject may be present."@en ;
    # The disjointness between the two leaves, made checkable: a tool's
    # graph records who is claiming, never who a member is. What the
    # content is about is the holding tool's own cell:formTopic, stated
    # once for all the graphs beneath it (:LiveToolShape above), so a
    # cell:FormGraph carries no about-ness property of its own at all.
    sh:property [
        sh:path cell:subject ;
        sh:maxCount 0 ;
        sh:message "A cell:FormGraph must not carry cell:subject — that property belongs to cell:MemberGraph, its disjoint sibling."@en
    ] .
