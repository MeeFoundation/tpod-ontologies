@prefix : <http://mee.foundation/ontologies/persona#> .
@prefix p: <http://mee.foundation/ontologies/persona#> .
@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pets: <http://mee.foundation/ontologies/pets#> .
@prefix vehicles: <http://mee.foundation/ontologies/vehicles#> .
@prefix identitydocuments: <http://mee.foundation/ontologies/identity-documents#> .
@prefix banking: <http://mee.foundation/ontologies/banking#> .
@prefix education: <http://mee.foundation/ontologies/education#> .
@base <http://mee.foundation/ontologies/persona> .

<http://mee.foundation/ontologies/persona> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/persona/4.25.0> ;
    owl:imports <https://w3id.org/cco-domains/domains/PersonOntology> ;
    owl:imports <https://w3id.org/cco-domains/domains/AddressOntology> ;
    owl:imports <https://w3id.org/cco-domains/domains/StagingOntology> ;
    dc:date "2026-09-19"^^xsd:date ;
    owl:versionInfo "Version 4.25.0 - the category ontology renamed to pod-categories, with the cat: prefix becoming podcat:"@en ;
    rdfs:label "Persona Ontology"@en ;
    rdfs:comment """Persona Ontology for the V4 App.

                    This application ontology extends PersonOntology, AddressOntology,
                    and StagingOntology for the V4 App

                    ARCHITECTURE:
                    This application ontology serves as:
                    1. Aggregation point (imports 3 domain ontologies)
                    2. Documentation (annotations show which classes Persona uses)
                    3. Extension point (Persona-specific terms: future: accounts, service providers)

                    GOVERNANCE MODEL:
                    - Domain ontologies (Person, Address, Staging): Import unchanged
                    - Persona extensions: Added here, may be promoted to domain ontologies if proven useful
                    - Application-specific patterns documented via usage annotations

                    FEATURES:
                    - Peer name architecture (not hierarchical PersonName)
                    - Slash URIs (content negotiation enabled)
                    - International standards alignment (Schema.org, FHIR, OpenID)
                    - Address history tracking (N addresses over lifetime with temporal bounds)
                    """@en ;

    # Document which domain classes this application uses
    p:usesRequiredClass cco:ent00000002 ,  # GivenName
                              cco:ent00000004 ,  # FamilyName
                              cco:ent00000008 ,  # SocialSecurityNumber
                              cco:ent00000010 ,  # USPostalAddress
                              cco:ent00000023 ,  # TelephoneNumber
                              cco:ent00000024 ;  # EmailAddress

    p:usesOptionalClass cco:ent00000001 ,  # FullName
                              cco:ent00000003 ,  # AdditionalName (middle name)
                              cco:ent00000005 ,  # Suffix (Jr., Sr., etc.)
                              cco:ent00000006 ,  # AlternateName
                              cco:ent00000016 ,  # AddressDesignation
                              cco:ent00000046 ,  # Birthdate
                              cco:ent00000047 ,  # OrganizationName
                              cco:ent00000051 ,  # Debit Card
                              cco:ent00000052 ,  # Credit Card Number (PAN)
                              cco:ent00000053 ,  # CVV
                              cco:ent00000054 ,  # Expiration Date Identifier
                              cco:ent00000057 ,  # Title (HonorificPrefix: Dr., Mr., Prof.)
                              cco:ent00000058 ,  # Surname2 (maternal surname)
                              cco:ont00000990 ;  # Nickname (CCO core)

    # Document CCO classes used directly (note: use full IRIs, not cco: prefix)
    p:usesCCOClass <https://w3id.org/cco-domains/cco/ont00001262> ,  # Person (superclass of persona:Person)
                         <https://w3id.org/cco-domains/cco/ont00001331> ,  # Legal Name
                         <https://w3id.org/cco-domains/cco/ont00000990> ,  # Nickname
                         <https://w3id.org/cco-domains/cco/ent00000033> ,  # Online Service Account (StagingOntology)
                         <https://w3id.org/cco-domains/cco/ont00000995> ,  # MaterialArtifact
                         <https://w3id.org/cco-domains/cco/ont00000020> ;  # Container

    # Document which properties this application uses (note: use full IRIs)
    p:usesCCOProperty <https://w3id.org/cco-domains/cco/ont00001879> ,            # designated by
                            <http://purl.obolibrary.org/obo/BFO_0000176> ,  # continuant part of (PhysicalCard → Wallet)
                            <http://purl.obolibrary.org/obo/BFO_0000178> ,  # has continuant part (Address → parts; Person → ScalpHair)
                            <https://w3id.org/cco-domains/cco/ont00001765> ,            # has text value
                            <http://purl.obolibrary.org/obo/BFO_0000196> ,  # bearer of
                            <http://purl.obolibrary.org/obo/BFO_0000199> ,  # occupies temporal region
                            <http://purl.obolibrary.org/obo/BFO_0000057> ,  # has participant
                            <https://w3id.org/cco-domains/cco/ent00000045> ,            # holds user account
                            <https://w3id.org/cco-domains/cco/ent00000034> ,            # has service name
                            <https://w3id.org/cco-domains/cco/ent00000035> ,            # has user handle
                            <https://w3id.org/cco-domains/cco/ent00000036> ,            # has service URI
                            <http://purl.obolibrary.org/obo/BFO_0000101> .  # is carrier of (PhysicalCard → Person)


#################################################################
#    Annotation Properties for Usage Documentation
#################################################################

p:usesRequiredClass rdf:type owl:AnnotationProperty ;
    rdfs:label "uses required class"@en ;
    rdfs:comment """Indicates a class from domain ontologies that this application REQUIRES.
                    These classes are mandatory in Persona's SHACL validation."""@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range owl:Class .

p:usesOptionalClass rdf:type owl:AnnotationProperty ;
    rdfs:label "uses optional class"@en ;
    rdfs:comment """Indicates a class from domain ontologies that this application OPTIONALLY uses.
                    These classes are allowed but not required in Persona's SHACL validation."""@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range owl:Class .

p:usesCCOClass rdf:type owl:AnnotationProperty ;
    rdfs:label "uses CCO class"@en ;
    rdfs:comment """Indicates a class from CCO core ontologies that this application uses directly
                    (not subclassed in domain ontologies). Values are full IRIs like
                    <https://w3id.org/cco-domains/cco/ont00001262>."""@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range owl:Class .

p:usesCCOProperty rdf:type owl:AnnotationProperty ;
    rdfs:label "uses CCO property"@en ;
    rdfs:comment """Indicates an object or data property from CCO that this application uses.
                    Values are full IRIs like <https://w3id.org/cco-domains/cco/ont00001879>."""@en ;
    rdfs:domain owl:Ontology .

p:usesDrOnClass rdf:type owl:AnnotationProperty ;
    rdfs:label "uses DrOn class"@en ;
    rdfs:comment """Indicates a class from the Drug Ontology (DrOn) that this application uses
                    directly, cited by its real upstream IRI (e.g.
                    <http://purl.obolibrary.org/obo/DRON_00000074>). Mirrors p:usesCCOClass's
                    documentation role, generalized to a second reused ontology family. This
                    project vendors only a small hand-curated subset of DrOn's upper module
                    (project_files/dron-upper.ttl), not the full ~300MB upstream distribution — see
                    that file's own rdfs:comment for why."""@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range owl:Class .

p:usesChEBIClass rdf:type owl:AnnotationProperty ;
    rdfs:label "uses ChEBI class"@en ;
    rdfs:comment """Indicates a class from ChEBI (Chemical Entities of Biological Interest) that
                    this application uses directly, cited by its real upstream IRI (e.g.
                    <http://purl.obolibrary.org/obo/CHEBI_2676>). Mirrors p:usesCCOClass's
                    documentation role. ChEBI itself is not vendored or owl:imported anywhere in
                    this project — it is far too large — its class IRIs are only ever cited as
                    external values (the same way DrOn itself reuses ChEBI rather than modeling
                    chemistry on its own)."""@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range owl:Class .

p:usagePattern rdf:type owl:AnnotationProperty ;
    rdfs:label "usage pattern"@en ;
    rdfs:comment """Describes how this application uses a particular class or property."""@en ;
    rdfs:domain owl:Class .


#################################################################
#    Person - V4-specific extension of cco:Person
#################################################################
p:Person rdf:type owl:Class ;
    rdfs:subClassOf <https://w3id.org/cco-domains/cco/ont00001262> ;  # CCO Person
    rdfs:label "Person"@en ;
    rdfs:comment """A V4-specific extension of CCO Person. Each graph file (named graph)
                    contains exactly one persona:Person individual representing the subject
                    of that graph. The same IRI is used for the same real-world person
                    across all graph files — each file is a named-graph slice of that
                    person's identity data."""@en .


#################################################################
#    Other properties
#################################################################

p:hasSocialNetwork rdf:type owl:ObjectProperty ;
    rdfs:domain p:Person ;
    rdfs:range cco:ont00001183 ;    # Social Network
    rdfs:label "has social network"@en ;
    rdfs:comment """Links a Person to a Social Network — the set of other people
                    with whom the person has relationships in that graph. The Person is
                    not a member of the network; the network contains only the people they
                    relate to."""@en .

p:hasPet rdf:type owl:ObjectProperty ;
    rdfs:domain p:Person ;
    rdfs:range pets:Pet ;    # other/pets.ttl, referenced by name — no owl:imports either direction
    rdfs:label "has pet"@en ;
    rdfs:comment """Links a Person to a Pet. What a pet *is* (species, breed, medications) is modeled
                    in the peer other/pets.ttl ontology, not here — this project keeps persona.ttl
                    scoped to a person's own identity, holding only the thin "has" link for anything
                    a person merely owns or is otherwise associated with (a pet, a vehicle, each in its
                    own other/*.ttl file — see p:hasVehicle below for the identical pattern). pets:Pet
                    is referenced by name only, the same "referenced by name, no owl:imports" pattern
                    pod.ttl already uses for pod:category's range (skos:Concept) and pod:creator's
                    range (p:Person/o:Organization)."""@en .

p:hasVehicle rdf:type owl:ObjectProperty ;
    rdfs:domain p:Person ;
    rdfs:range vehicles:Vehicle ;    # other/vehicles.ttl, referenced by name — no owl:imports either direction
    rdfs:label "has vehicle"@en ;
    rdfs:comment """Links a Person to a Vehicle. What a vehicle *is* (type, make, model, specifications)
                    is modeled in the peer other/vehicles.ttl ontology, not here — the exact same "thin
                    has-link" pattern p:hasPet already establishes for other/pets.ttl. vehicles:Vehicle
                    is referenced by name only, no owl:imports either direction."""@en .

p:hasIdentityDocument rdf:type owl:ObjectProperty ;
    rdfs:domain p:Person ;
    rdfs:range identitydocuments:IdentityDocument ;    # other/identity-documents.ttl, referenced by name — no owl:imports either direction
    rdfs:label "has identity document"@en ;
    rdfs:comment """Links a Person to a government-issued identity document they hold. What an identity
                    document *is* (birth certificate, driver's license, passport — each a subclass of
                    identitydocuments:IdentityDocument, each with its own identity claims) is modeled in
                    the peer other/identity-documents.ttl ontology, not here — the exact same "thin
                    has-link" pattern p:hasPet/p:hasVehicle already establish for
                    other/pets.ttl/other/vehicles.ttl, and the one place in this project where that
                    pattern's abstract-superclass fan-out really earns its keep: one link property here
                    serves three concrete document subtypes there. identitydocuments:IdentityDocument is
                    referenced by name only, no owl:imports either direction."""@en .

#################################################################
#    Banking-related
#################################################################

p:hasBankAccount rdf:type owl:ObjectProperty ;
    rdfs:domain p:Person ;
    rdfs:range banking:CheckingAccount ;    # other/banking.ttl, referenced by name — no owl:imports either direction
    rdfs:label "holds bank account"@en ;
    rdfs:comment """Links a Person to a bank account it records. What a checking account (or the debit
                    card that draws on it) *is* lives in the peer other/banking.ttl ontology, not here —
                    the same thin has-link pattern p:hasPet/p:hasVehicle/p:hasIdentityDocument already
                    establish; banking:CheckingAccount is referenced by name only, no owl:imports either
                    direction. banking:accessesBankAccount (DebitCard → CheckingAccount) lives there too,
                    since neither of its endpoints is a p:Person."""@en .

#################################################################
#    Education-related
#################################################################

p:hasEducation rdf:type owl:ObjectProperty ;
    rdfs:domain p:Person ;
    rdfs:range education:EducationRecord ;    # other/education.ttl, referenced by name — no owl:imports either direction
    rdfs:label "has education"@en ;
    rdfs:comment """Links a Person to a record of one stage of their schooling — a secondary school, a
                    college or university, or a further qualification. Repeat the property for each:
                    a person has as many records as they have stages. What an education record *is*
                    lives in the peer other/education.ttl ontology, not here — the same thin has-link
                    pattern p:hasPet/p:hasVehicle/p:hasIdentityDocument/p:hasBankAccount already
                    establish; education:EducationRecord is referenced by name only, no owl:imports
                    either direction. Which stage a given record represents is carried there by
                    education:educationLevel, so this one property serves every stage rather than
                    there being a separate link per stage."""@en .


#################################################################
#    Physical Belongings: Physical cards
#################################################################

p:PhysicalCard rdf:type owl:Class ;
    rdfs:subClassOf <https://w3id.org/cco-domains/cco/ont00000995> ;  # MaterialArtifact
    rdfs:label "Physical Card"@en ;
    rdfs:comment "A physical card (e.g. driver's license, health insurance card) carried in a wallet."@en .

p:Wallet rdf:type owl:Class ;
    rdfs:subClassOf <https://w3id.org/cco-domains/cco/ont00000020> ;  # Container (subclass of MaterialArtifact)
    rdfs:label "Wallet"@en ;
    rdfs:comment "A physical wallet that holds cards and other personal documents."@en .

p:PhysicalDriversLicense rdf:type owl:Class ;
    rdfs:subClassOf p:PhysicalCard ;
    rdfs:label "Physical Driver's License"@en ;
    rdfs:comment "A physical (e.g. plastic) state-issued driver's license card."@en .

p:PhysicalHealthInsuranceCard rdf:type owl:Class ;
    rdfs:subClassOf p:PhysicalCard ;
    rdfs:label "Physical Health Insurance Card"@en ;
    rdfs:comment "A physical (e.g. plastic) health insurance membership card."@en .

p:PhysicalPaymentCard rdf:type owl:Class ;
    rdfs:subClassOf p:PhysicalCard ;
    rdfs:label "Physical Payment Card"@en ;
    rdfs:comment "A physical plastic credit or debit card."@en .

p:PhysicalSocialSecurityCard rdf:type owl:Class ;
    rdfs:subClassOf p:PhysicalCard ;
    rdfs:label "Physical Social Security Card"@en ;
    rdfs:comment "A paper or plastic card issued by the Social Security Administration."@en .

p:hasPhysicalCard rdf:type owl:ObjectProperty ;
    rdfs:domain p:Person ;
    rdfs:range p:PhysicalCard ;
    rdfs:label "holds physical card"@en ;
    rdfs:comment """Links a Person to a PhysicalCard they possess, whether carried directly, stored separately, or held inside a wallet (see p:hasWallet and continuant part of for the separate, complementary fact of a card's wallet containment)."""@en .

p:hasWallet rdf:type owl:ObjectProperty ;
    rdfs:domain p:Person ;
    rdfs:range p:Wallet ;
    rdfs:label "holds wallet"@en ;
    rdfs:comment "Links a Person to the physical wallet they carry."@en .

p:hasImageScan rdf:type owl:DatatypeProperty ;
    rdfs:domain p:PhysicalCard ;
    rdfs:range xsd:anyURI ;
    rdfs:label "has image scan"@en ;
    rdfs:comment "A URI pointing to a scanned image of the physical (e.g. plastic, paper) card."@en .


#################################################################
#    ContactInfo and related properties
#################################################################

p:ContactInfo rdf:type owl:Class ;
    rdfs:label "Contact Info"@en ;
    rdfs:comment """Label for a graph whose purpose is to carry professional
                    contact details in the JSContact (RFC 9553) format. OrganizationName and
                    at least one contact channel (email or phone) are required. Never asserted
                    via rdf:type anywhere — a label only; the graph's own pod:shape
                    value instead names the validating shape, pshapes:ContactInfoShape
                    (shacl/contactinfo-shacl.ttl), directly. Unlike the record/document classes
                    that moved out to other/*.ttl peer ontologies, everything in this section is
                    a property of a p:Person directly, reused across every category's member
                    graph, so it belongs here in persona.ttl rather than in a domain file."""@en .


#  1. Contact Channel Annotation Properties
#     Used on designated-by blank nodes to record JSContact context
#     labels (work/home/other) and phone feature flags.

p:contactContext rdf:type owl:AnnotationProperty ;
    rdfs:label "contact context"@en ;
    rdfs:comment """JSContact 'contexts' key on an email, phone, or address entry.
                    Controlled vocabulary: 'work', 'home', 'other', 'billing' (address),
                    'delivery' (address)."""@en ;
    rdfs:range xsd:string .

p:phoneFeature rdf:type owl:AnnotationProperty ;
    rdfs:label "phone feature"@en ;
    rdfs:comment """JSContact phone 'features' flag. Repeat the property for multiple features.
                    Controlled vocabulary: 'voice', 'fax', 'text', 'video', 'pager',
                    'textphone', 'mobile'."""@en ;
    rdfs:range xsd:string .

p:serviceLabel rdf:type owl:AnnotationProperty ;
    rdfs:label "service label"@en ;
    rdfs:comment """JSContact 'service' field on an onlineServices entry. Identifies which
                    platform the OnlineServiceAccount or WebURL belongs to.
                    Examples: 'twitter', 'linkedin', 'github', 'mastodon'."""@en ;
    rdfs:range xsd:string .


#  2. Name Component Designator Classes
#     All are subclasses of cco:ont00000003 (Designative Name),
#     consistent with GivenName, FamilyName, OrganizationName, etc.

p:Credential rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00000003 ;  # Designative Name
    rdfs:label "Credential"@en ;
    rdfs:comment """A post-nominal professional or academic credential that follows a
                    person's name. Examples: 'MD', 'PhD', 'Esq.', 'CPA', 'MBA'.
                    Distinct from cco:ent00000057 (Title/HonorificPrefix) which precedes
                    the name, and from cco:ent00000005 (Suffix) which covers generational
                    suffixes (Jr., Sr., III).
                    JSContact: name component kind 'credential'."""@en .


#  3. Online Service Designator Class

p:WebURL rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00000003 ;  # Designative Name
    rdfs:label "Web URL"@en ;
    rdfs:comment """A URL that designates a person's web presence — personal website, blog,
                    portfolio, or profile page. Distinct from cco:ent00000033
                    (OnlineServiceAccount) which represents a login-based account.
                    Attach p:serviceLabel to identify the platform where relevant.
                    JSContact: onlineServices entry with a URI value."""@en .


#  4. Organisation Designator Classes

p:OrganizationUnit rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00000003 ;  # Designative Name
    rdfs:label "Organization Unit"@en ;
    rdfs:comment """A Designative Name identifying a department, division, or other
                    sub-unit within an organization. Typically paired with an
                    OrganizationName (cco:ent00000047) on the same Person.
                    Examples: 'Engineering', 'Sales', 'R&D'.
                    JSContact: organizations[*].units array entry."""@en .

p:JobTitle rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00000003 ;  # Designative Name
    rdfs:label "Job Title"@en ;
    rdfs:comment """A Designative Name for a person's position or role within an
                    organisation. Examples: 'Software Engineer', 'VP of Sales',
                    'Chief Medical Officer'.
                    Distinct from cco:ent00000057 (Title/HonorificPrefix) which is an
                    honorific preceding the name (Dr., Prof., Mr.).
                    JSContact: titles[*].name."""@en .


#  5. Anniversary Class and Properties
#     A named individual of type p:Anniversary is attached to a
#     Person via p:hasAnniversary.

p:Anniversary rdf:type owl:Class ;
    rdfs:label "Anniversary"@en ;
    rdfs:comment """A personally significant recurring date, such as a wedding anniversary
                    or other custom commemoration. Birthdays use cco:ent00000046 (Birthdate)
                    directly on the Person via designated-by; Anniversary covers all other
                    recurring dates.
                    JSContact: anniversaries map (excluding 'birth' and 'death' kinds)."""@en .

p:hasAnniversary rdf:type owl:ObjectProperty ;
    rdfs:label "has anniversary"@en ;
    rdfs:comment "Links a p:Person to one of its Anniversary individuals."@en ;
    rdfs:range p:Anniversary .

p:anniversaryKind rdf:type owl:DatatypeProperty ;
    rdfs:label "anniversary kind"@en ;
    rdfs:comment """The type of anniversary. Controlled vocabulary: 'wedding', 'custom'.
                    JSContact: anniversaries[*].kind."""@en ;
    rdfs:domain p:Anniversary ;
    rdfs:range xsd:string .

p:anniversaryDate rdf:type owl:DatatypeProperty ;
    rdfs:label "anniversary date"@en ;
    rdfs:comment """The calendar date of the anniversary. Use xsd:date ('YYYY-MM-DD') for
                    fully known dates; xsd:gMonthDay ('--MM-DD') for day/month only.
                    JSContact: anniversaries[*].date."""@en ;
    rdfs:domain p:Anniversary .

p:anniversaryLabel rdf:type owl:DatatypeProperty ;
    rdfs:label "anniversary label"@en ;
    rdfs:comment """Human-readable label for a 'custom' anniversary.
                    JSContact: anniversaries[*].label."""@en ;
    rdfs:domain p:Anniversary ;
    rdfs:range xsd:string .


#  6. PersonalInfo Class and Properties
#     A named individual of type p:PersonalInfo is attached to a
#     Person via p:hasPersonalInfo.

p:PersonalInfo rdf:type owl:Class ;
    rdfs:label "Personal Info"@en ;
    rdfs:comment """A record of a person's hobby, personal interest, or area of expertise.
                    JSContact: personalInfo map entries."""@en .

p:hasPersonalInfo rdf:type owl:ObjectProperty ;
    rdfs:label "has personal info"@en ;
    rdfs:comment "Links a p:Person to one of its PersonalInfo individuals."@en ;
    rdfs:range p:PersonalInfo .

p:personalInfoKind rdf:type owl:DatatypeProperty ;
    rdfs:label "personal info kind"@en ;
    rdfs:comment """The category of personal information.
                    Controlled vocabulary: 'expertise', 'hobby', 'interest'.
                    JSContact: personalInfo[*].kind."""@en ;
    rdfs:domain p:PersonalInfo ;
    rdfs:range xsd:string .

p:personalInfoValue rdf:type owl:DatatypeProperty ;
    rdfs:label "personal info value"@en ;
    rdfs:comment """The subject matter — e.g. 'rock climbing', 'jazz piano', 'Rust'.
                    JSContact: personalInfo[*].value."""@en ;
    rdfs:domain p:PersonalInfo ;
    rdfs:range xsd:string .

p:personalInfoLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "personal info level"@en ;
    rdfs:comment """Self-assessed proficiency level for expertise entries.
                    Controlled vocabulary: 'high', 'medium', 'low'.
                    JSContact: personalInfo[*].level."""@en ;
    rdfs:domain p:PersonalInfo ;
    rdfs:range xsd:string .


#  7. Photo Property

p:hasPhoto rdf:type owl:DatatypeProperty ;
    rdfs:label "has photo"@en ;
    rdfs:comment """A URI pointing to a photo or avatar image for this Person.
                    Repeat the property for multiple photos (e.g. work headshot vs
                    informal photo). Use p:contactContext as an annotation on
                    the reified statement if context labeling is needed.
                    Also used on an identitydocuments:IdentityDocument individual, whose own
                    SHACL shapes (other/shacl/identity-documents-shacl.ttl) constrain it to at
                    most one value — hence no rdfs:domain here.
                    JSContact: photos[*].uri."""@en ;
    rdfs:range xsd:anyURI .


#  8. PersonalityAssessment Class and Properties
#     A named individual of type p:PersonalityAssessment is attached to a
#     Person via p:hasPersonalityAssessment.

p:PersonalityAssessment rdf:type owl:Class ;
    rdfs:label "Personality Assessment"@en ;
    rdfs:comment "A self-assessment of personality, temperament, or social style from a named framework (e.g. Myers-Briggs, Big Five, DISC, Enneagram)."@en .

p:hasPersonalityAssessment rdf:type owl:ObjectProperty ;
    rdfs:label "has personality assessment"@en ;
    rdfs:comment "Links a p:Person to one of its PersonalityAssessment individuals."@en ;
    rdfs:range p:PersonalityAssessment .

p:personalityFramework rdf:type owl:DatatypeProperty ;
    rdfs:label "personality framework"@en ;
    rdfs:comment "The named framework or instrument the result comes from — e.g. 'MBTI', 'Big Five', 'DISC', 'Enneagram', 'Social Style', or another named framework."@en ;
    rdfs:domain p:PersonalityAssessment ;
    rdfs:range xsd:string .

p:personalityResult rdf:type owl:DatatypeProperty ;
    rdfs:label "personality result"@en ;
    rdfs:comment "The self-assessed result or type code within that framework — e.g. 'INFJ' (MBTI), 'Type 4' (Enneagram), 'Dominance' (DISC), or a Big Five score summary."@en ;
    rdfs:domain p:PersonalityAssessment ;
    rdfs:range xsd:string .

p:personalityAssessmentDate rdf:type owl:DatatypeProperty ;
    rdfs:label "personality assessment date"@en ;
    rdfs:comment "The date the self-assessment was taken or last confirmed."@en ;
    rdfs:domain p:PersonalityAssessment ;
    rdfs:range xsd:date .


#################################################################
#    Medical specialty
#################################################################

p:specialty rdf:type owl:DatatypeProperty ;
    rdfs:domain p:Person ;
    rdfs:range xsd:string ;
    rdfs:label "specialty"@en ;
    rdfs:comment """A physician's medical specialty, as a single free-text string (e.g.
                    'Endocrinology') — asserted on the physician's own Person individual
                    directly, which is why it stays here rather than moving to
                    other/medical-appointments.ttl alongside
                    medicalappointments:MedicalAppointmentRecord's own claim properties, whose
                    domain is that record individual rather than a Person. Backs
                    podcat:PrimaryCarePhysician's own pod:formShape,
                    pshapes:PrimaryCarePhysicianShape (shacl/persona-shacl.ttl)."""@en .


#################################################################
#    Usage Pattern Documentation on Specific Classes
#################################################################

cco:ent00000001
    p:usagePattern """Person accepts FullName as complete string alternative
                            to structured components. SHACL validation: EITHER FullName OR
                            (GivenName + FamilyName) required."""@en .

cco:ent00000002
    p:usagePattern """Legal first name. Required if FullName not provided.
                            Multiple GivenNames allowed (e.g., 'Mary Anne')."""@en .

cco:ent00000004
    p:usagePattern """Legal last/surname. Required if FullName not provided."""@en .

cco:ent00000003
    p:usagePattern """Middle names or additional given names. Optional.
                            Use for names person goes by that aren't their legal first name."""@en .

cco:ent00000006
    p:usagePattern """Any alternative form of the person's name (nicknames,
                            preferred names, previous names). Optional."""@en .

cco:ent00000008
    p:usagePattern """US SSN in format NNN-NN-NNNN. Required for identity verification."""@en .

cco:ent00000010
    p:usagePattern """Primary residential address. Required. Must include street,
                            city, state, ZIP. Country optional."""@en .

cco:ent00000024
    p:usagePattern """Primary email address. Required for account access."""@en .

cco:ent00000023
    p:usagePattern """Primary phone number. Required. Prefer E.164 format."""@en .

cco:ent00000016
    p:usagePattern """Used to track address history with temporal bounds. Each designation
                            represents a person living at an address during a specific time period.
                            Use BFO 'occupies temporal region' to specify the time interval with
                            start and optional end dates. An open-ended interval (no end date)
                            indicates current address. Supports N addresses over a person's lifetime."""@en .

cco:ent00000051
    p:usagePattern """Debit card held by a Person, linked via cco:ent00000073 (has payment card).
                            Designated by a CreditCardNumber (ent00000052), CVV (ent00000053),
                            and — via has expiration date (cco:ent00000070) — a Calendar Date
                            Identifier (cco:ont00001340)."""@en .
